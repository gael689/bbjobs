# App
ENV=development
DEBUG=true
SECRET_KEY=replace-me-with-a-secure-secret-key

# Database — DATABASE_URL es el rol de mínimo privilegio que usa la app en runtime (sin DDL).
# MIGRATIONS_DATABASE_URL es el rol con privilegios de owner que corre `alembic upgrade head`
# (necesita CREATE TABLE/ALTER TABLE). Si se deja vacía, alembic cae a DATABASE_URL — sólo
# andaría si ese rol también tiene DDL, que no es el caso una vez hecho el split (ver
# SEGURIDAD-PLAN.md bloque E).
DATABASE_URL=postgresql+asyncpg://app_user:app_user@localhost:5432/bbjobs
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://bbjobs:bbjobs@localhost:5432/bbjobs

# Clerk (auth provider)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# CORS
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Sentry
SENTRY_DSN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Módulos en desarrollo (mails, IA, Revisión de CV). En producción queda en false hasta el
# lanzamiento: nadie los ve, ni el panel de admin. En local, true para desarrollar.
MODULOS_NUEVOS_ACTIVOS=false
# Secreto compartido con el centro para la sincronización de empresas (python -c "import secrets; print(secrets.token_hex(32))").
LEADGEN_SYNC_SECRET=

# Mails — Resend (MODULOS-MAILS-IA-PLAN.md). Vacío = los mails se saltean, no rompe nada.
RESEND_API_KEY=
RESEND_FROM_EMAIL=BBJobs <avisos@bbjobs.com.ar>
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=
# auto (resend si hay key, off si no) | off | simulate | resend
EMAIL_MODE=auto
# Tope diario de calentamiento del dominio (0 = sin tope). Arranca en 150 y se sube por semana.
EMAIL_DAILY_CAP=150

# IA — Gemini. Vacío = recomendaciones y resúmenes de evaluación desactivados.
# Con perfiles reales hace falta la cuenta con facturación activada (el nivel gratuito puede
# usar lo que se envía para mejorar productos de Google) — ver plan §4.B.1.
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_THINKING_LEVEL=minimal
GEMINI_SEED=20261004

# Seed (python seed.py) — obligatorio en producción, seed.py no tiene default inseguro
ADMIN_EMAIL=admin@bbjobs.com.ar
ADMIN_PASSWORD=
