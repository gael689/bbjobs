# App
ENV=development
DEBUG=true
SECRET_KEY=replace-me-with-a-secure-secret-key

# Database
DATABASE_URL=postgresql+asyncpg://bbjobs:bbjobs@localhost:5432/bbjobs

# Auth (legacy JWT — deprecado por Clerk, ver docs/planning/backend/09-migracion-clerk-auth.md)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Clerk (auth provider)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
